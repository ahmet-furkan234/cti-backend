NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cti:cti_dev_password@localhost:5440/cti
ALLOWED_ORIGINS=http://localhost:3100
WEB_BASE_URL=http://localhost:3100
REDIS_URL=redis://localhost:6390
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
# First super admin (created by db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!

# Mobile push through Firebase Cloud Messaging (optional until you set up Firebase)
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Use either a path to the JSON file or the JSON itself (e.g. for containers).
# FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
